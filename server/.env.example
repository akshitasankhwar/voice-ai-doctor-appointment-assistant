# Copy to server/.env and fill in. Never commit .env.

# Google Gemini (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional: override the Gemini model (default: gemini-2.5-flash)
# GOOGLE_MODEL=gemini-2.5-flash

# ElevenLabs (STT + TTS): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: a voice ID from your ElevenLabs "My Voices" (default: premade "Sarah").
# Free plans cannot use Voice Library voices through the API.
# ELEVENLABS_VOICE_ID=

# Optional server settings
# HOST=localhost
# PORT=7860
# CORS_ORIGINS=http://localhost:5173
# DB_PATH=./clinic.db
